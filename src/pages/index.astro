---
import Layout from '../layouts/Layout.astro';
---

<Layout title="BMI Calculator – QuickBMICalc.com">
	<main class="calculator-container">
		<div class="app-layout">
			<!-- Column 1: Calculator Card -->
			<div class="card">
				<div class="card-title-bar">
					<h1>BMI Calculator</h1>
					<button id="theme-toggle" class="theme-toggle-btn" aria-label="Toggle theme">
						<!-- Sun Icon -->
						<svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0s-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0s.39-1.03 0-1.41l-1.06-1.06zm1.06-12.37c-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41zm-12.37 12.37c-.39-.39-1.03-.39-1.41 0l-1.06 1.06c-.39.39-.39 1.03 0 1.41s1.03.39 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41z"/></svg>
						<!-- Moon Icon -->
						<svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12.3 22h-.1c-5.5 0-10-4.5-10-10 0-4.8 3.5-8.9 8.2-9.8.6-.1 1.2.3 1.3.9.1.6-.3 1.2-.9 1.3-3.7.7-6.4 3.9-6.4 7.7 0 4.4 3.6 8 8 8 3.8 0 7-2.7 7.7-6.4.1-.6.7-1 1.3-.9.6.1 1 .7.9 1.3-.9 4.7-5 8.2-9.9 8.2z"/></svg>
					</button>
				</div>
				
				<p class="description">
					Enter your weight and height to calculate your Body Mass Index (BMI).
				</p>

				<form id="bmi-form" novalidate>
					<!-- Unit Toggle -->
					<fieldset class="toggle-fieldset">
						<legend class="sr-only">Choose measurement system</legend>
						<div class="toggle-container">
							<label class="toggle-option">
								<input type="radio" name="unit-system" value="metric" checked />
								<span>Metric (kg/cm)</span>
							</label>
							<label class="toggle-option">
								<input type="radio" name="unit-system" value="imperial" />
								<span>Imperial (lb/in)</span>
							</label>
						</div>
					</fieldset>

					<!-- Weight Input -->
					<div class="input-group">
						<label for="weight" id="weight-label">Weight (kg)</label>
						<input 
							type="number" 
							id="weight" 
							name="weight" 
							step="any" 
							required 
							placeholder="Weight" 
							min="1"
						/>
						<span class="error-text" id="weight-error">Please enter a valid weight (greater than 0).</span>
					</div>

					<!-- Height Input - Metric (cm) -->
					<div class="input-group" id="height-metric-container">
						<label for="height" id="height-label">Height (cm)</label>
						<input 
							type="number" 
							id="height" 
							name="height" 
							step="any" 
							required 
							placeholder="Height" 
							min="1"
						/>
						<span class="error-text" id="height-error">Please enter a valid height (greater than 0).</span>
					</div>

					<!-- Height Input - Imperial (ft / in) -->
					<div class="input-group hidden" id="height-imperial-container">
						<label>Height</label>
						<div class="double-input-container">
							<div class="sub-input-group">
								<label for="height-ft" class="sr-only">Feet</label>
								<input 
									type="number" 
									id="height-ft" 
									name="height-ft" 
									placeholder="Feet" 
									min="0"
								/>
								<span class="input-suffix">ft</span>
							</div>
							<div class="sub-input-group">
								<label for="height-in" class="sr-only">Inches</label>
								<input 
									type="number" 
									id="height-in" 
									name="height-in" 
									placeholder="Inches" 
									min="0" 
									max="11.9" 
									step="any"
								/>
								<span class="input-suffix">in</span>
							</div>
						</div>
						<span class="error-text" id="imperial-height-error">Please enter a valid height (greater than 0).</span>
					</div>

					<!-- Submit Button -->
					<button type="submit" id="calculate-btn">
						Calculate BMI
					</button>
				</form>

				<!-- Results Area -->
				<div id="result" class="result hidden" aria-live="polite">
					<div class="result-header">
						<h2>Your BMI</h2>
					</div>
					<div class="result-display">
						<span id="bmi-value" class="bmi-value">--.-</span>
						<span id="bmi-category" class="bmi-category">Normal</span>
					</div>
					<div class="bmi-meter-container">
						<div class="bmi-meter-bg">
							<div id="bmi-meter-bar" class="bmi-meter-bar"></div>
						</div>
						<div class="bmi-meter-labels">
							<span>18.5</span>
							<span>25</span>
							<span>30</span>
						</div>
					</div>
				</div>

				<!-- Footer Disclaimer -->
				<footer class="card-footer">
					<p class="disclaimer">
						BMI is a screening measure and not a diagnostic tool. Consult a healthcare provider.
					</p>
				</footer>
			</div>

			<!-- Column 2: Informative Cards -->
			<div class="info-section">
				<!-- Card A: Classification Reference Table -->
				<div class="info-card">
					<h2>BMI Categories Chart</h2>
					<p class="description">
						World Health Organization (WHO) standard categories for adult body weight classifications:
					</p>
					<table class="classification-table" id="classification-table">
						<thead>
							<tr>
								<th>Category</th>
								<th>BMI Range</th>
							</tr>
						</thead>
						<tbody>
							<tr id="row-underweight" data-category="underweight">
								<td>Underweight</td>
								<td>&lt; 18.5</td>
							</tr>
							<tr id="row-normal" data-category="normal">
								<td>Healthy Weight</td>
								<td>18.5 – 24.9</td>
							</tr>
							<tr id="row-overweight" data-category="overweight">
								<td>Overweight</td>
								<td>25.0 – 29.9</td>
							</tr>
							<tr id="row-obese" data-category="obese">
								<td>Obese</td>
								<td>&ge; 30.0</td>
							</tr>
						</tbody>
					</table>
				</div>

				<!-- Card B: Healthy Weight Tips -->
				<div class="info-card">
					<h2>Healthy Weight Tips</h2>
					<ul class="tips-list">
						<li><strong>Balanced Diet:</strong> Prioritize whole foods, fiber-rich vegetables, lean proteins, and complex carbohydrates.</li>
						<li><strong>Regular Movement:</strong> Aim for 150 minutes of moderate activity or aerobic exercise weekly.</li>
						<li><strong>Adequate Hydration:</strong> Drink plenty of water throughout the day; restrict sugary soda drinks.</li>
						<li><strong>Sleep Health:</strong> Focus on getting 7-9 hours of restful sleep to optimize metabolism hormones.</li>
					</ul>
				</div>

				<!-- Card C: Privacy Commitment -->
				<div class="info-card">
					<h2>100% Privacy‑First</h2>
					<p class="info-text">
						All calculation math happens strictly inside your local browser sandbox. We do not transmit, analyze, or upload your parameters to any cloud servers. Free of ads and tracking.
					</p>
				</div>
			</div>
		</div>
	</main>
</Layout>

<script src="../scripts/bmi.js"></script>
